{
  "manifest_version": 3,
  "name": "ChatGPT Usage OLED096 Local Bridge",
  "version": "1.0.0",
  "description": "把已登录 ChatGPT Usage 页面中可见的 5 小时和每周剩余额度同步到本机桥接服务。",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

